{
  "name": "backend-challenge",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "nest build",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "nest start --debug --watch",
    "test": "bun test test/unit",
    "test:integration": "bun test --max-concurrency=1 test/integration",
    "test:integration:commit-ack": "POSTGRES_DB=wagering ALLOW_ORIGINAL_DB_INTEGRATION=1 bun test test/integration/messaging/sqs-commit-before-ack.spec.ts",
    "test:integration:retry-dlq": "bun test test/integration/messaging/sqs-retry-dlq.spec.ts",
    "test:integration:outbox-recovery": "POSTGRES_DB=wagering ALLOW_ORIGINAL_DB_INTEGRATION=1 bun test test/integration/messaging/outbox-crash-recovery.spec.ts",
    "test:integration:sqs-shutdown": "bun test test/integration/messaging/sqs-shutdown.spec.ts"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
